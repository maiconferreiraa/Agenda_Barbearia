# Copie este arquivo para ".env" e preencha com as credenciais do SEU projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > Config do SDK)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave pública VAPID para notificações push (Console Firebase > Cloud Messaging > Certificados web push)
VITE_FIREBASE_VAPID_KEY=

# O código secreto do proprietário NÃO fica aqui (ficaria visível no navegador de qualquer pessoa).
# Ele é configurado como secret nas Cloud Functions — veja functions/README.md.

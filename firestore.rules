rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner();
      // Todo cadastro nasce como cliente. Virar "owner" só pelo servidor
      // (/api/claimOwnerRole, com o código do proprietário), que ignora estas regras.
      allow create: if isSelf(uid) && request.resource.data.role == 'client';
      // Ninguém troca o próprio papel (role) direto pelo app.
      allow update: if isSelf(uid) &&
        request.resource.data.role == resource.data.role;
    }

    // ---- usuários de login (maicon.ferreira → uid): só o servidor lê e grava ----
    match /usernames/{username} {
      allow read, write: if false;
    }

    // ---- catálogo público (leitura por qualquer usuário logado) ----
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    match /businessSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // ---- agendamentos ----
    // Criar, desmarcar e mudar status só pelo servidor (/api/*), que também
    // desconta e devolve os créditos do plano.
    match /appointments/{appointmentId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow update: if false;
      allow create, delete: if false;
    }

    // ---- dados só do dono (ex.: taxas da InfinitePay) — cliente não lê ----
    match /ownerSettings/{docId} {
      allow read, write: if isOwner();
    }

    // ---- códigos de ligação de conta (só o servidor) ----
    match /linkCodes/{uid} {
      allow read, write: if false;
    }

    // ---- feriados e dias fechados (o servidor avisa os clientes) ----
    match /holidays/{day} {
      allow read, write: if isOwner();
    }

    // ---- horários bloqueados pelo dono na agenda (o servidor desconta dos livres) ----
    match /agendaBlocks/{blockId} {
      allow read, write: if isOwner();
    }

    // ---- horários cancelados (resumo para o relatório; o horário em si é apagado) ----
    match /canceledAppointments/{appointmentId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ---- assinaturas (planos assinados) ----
    // Só o servidor (/api/*, webhook e régua diária) cria/altera.
    match /subscriptions/{subscriptionId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    // ---- saídas (aluguel, energia, água, itens do salão...) — só o dono ----
    match /expenses/{expenseId} {
      allow read, write: if isOwner();
    }

    // ---- mensalidades (uma por mês, com link InfinitePay) ----
    match /invoices/{invoiceId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    // ---- WhatsApp da barbearia: QR para conectar e status (só o dono) ----
    // A ponte (conta de serviço) publica o QR/código; o dono pode pedir o código
    // de pareamento (conectar só pelo celular) ou desconectar.
    match /private/{docId} {
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['command', 'pairPhone'])
        && request.resource.data.command in ['logout', 'pair'];
    }

    // ---- fila de WhatsApp (só o servidor e a ponte local, com a conta de serviço) ----
    match /whatsappOutbox/{messageId} {
      allow read, write: if false;
    }

    // ---- pagamentos (histórico, gerado pelo webhook) ----
    match /payments/{paymentId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    // ---- notificações ----
    match /notifications/{notificationId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.targetUserId == request.auth.uid);
      // Cliente/dono só pode marcar como lida (read: true), nada mais.
      allow update: if (isOwner() || (isSignedIn() && resource.data.targetUserId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // "Limpar histórico": o dono apaga as da barbearia; o cliente, só as dele.
      allow delete: if (isOwner() && resource.data.targetRole == 'owner')
        || (isSignedIn() && resource.data.targetUserId == request.auth.uid);
      allow create: if false;
    }
  }
}

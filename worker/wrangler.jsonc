// Barbearia Prime — app (app/dist) + servidor (/api/*) + régua de cobrança (cron).
// Login e banco continuam no Firebase (plano grátis Spark).
{
  "name": "barbearia-prime",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Régua de cobrança em pedaços (limite de 50 chamadas externas por execução no plano grátis):
  // a cada 10 min das 9h às 20h50 de Brasília (12:00–23:50 UTC).
  "triggers": { "crons": ["*/10 12-23 * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "barbearia-prime-app",
    // chave pública do app web (não é segredo; está no próprio app)
    "FIREBASE_WEB_API_KEY": "AIzaSyALkLGzksmS-lsUdA7_-MgyE-sDRjKlBDs",
    "APP_BASE_URL": "https://barbearia-prime.pages.dev"
  }
  // Segredos (wrangler secret put): GOOGLE_SERVICE_ACCOUNT (JSON da conta de serviço), OWNER_INVITE_CODE
}
